DESCRIPTION="Manage the system-wide coreutils provider (GNU vs uutils)"
MAINTAINER="diodon.frost@diodonfrost.me"
VERSION="0.3.0"

# /usr/local/bin sits ahead of /usr/bin in the default Gentoo PATH, so
# symlinks created here transparently override the matching /usr/bin/<util>
# for every shell, sudo session, cron job, and systemd unit using the
# standard system PATH — no PATH editing or relogin required.
OVERRIDE_DIR="/usr/local/bin"

# File recording the currently active provider.
STATE_FILE="/var/lib/eselect-coreutils/active"

# Known providers, in display order.
PROVIDERS=( gnu uutils )

# Read the active provider name from the state file, or "" if unset.
get_active_provider() {
	local state="${EROOT}${STATE_FILE}"
	[[ -r ${state} ]] && < "${state}" tr -d '[:space:]'
}

# Persist the active provider name.
set_active_provider() {
	local provider=$1
	local state="${EROOT}${STATE_FILE}"
	local state_dir="${state%/*}"
	[[ -d ${state_dir} ]] || mkdir -p "${state_dir}" \
		|| die -q "Cannot create ${state_dir}"
	echo "${provider}" > "${state}" \
		|| die -q "Cannot write ${state}"
}

clear_active_provider() {
	local state="${EROOT}${STATE_FILE}"
	[[ -e ${state} ]] && { rm -f "${state}" || die -q "Cannot remove ${state}"; }
}

# A symlink we manage points to /usr/bin/uu-<basename>.
is_managed_symlink() {
	local link=$1
	[[ -L ${link} ]] || return 1
	local target name
	target=$(readlink "${link}") || return 1
	name=${link##*/}
	[[ ${target} == "/usr/bin/uu-${name}" ]]
}

# Drop every symlink in OVERRIDE_DIR that points into /usr/bin/uu-*.
# Files we did not create are left untouched. /bin/rm is used by
# absolute path to avoid bash's command-hash holding a stale entry
# for /usr/local/bin/rm after we just removed that very symlink.
remove_managed_symlinks() {
	local dir="${EROOT}${OVERRIDE_DIR}"
	local link target
	[[ -d ${dir} ]] || return 0
	while IFS= read -r -d '' link; do
		target=$(readlink "${link}") || continue
		[[ ${target} == /usr/bin/uu-* ]] || continue
		/bin/rm -f "${link}" || die -q "Cannot remove ${link}"
	done < <(find "${dir}" -maxdepth 1 -type l -print0)
}

# Auto-discover /usr/bin/uu-* and link each into OVERRIDE_DIR, refusing
# to clobber anything that is not already one of our managed symlinks.
install_uutils_overrides() {
	local dir="${EROOT}${OVERRIDE_DIR}"
	[[ -d ${dir} ]] || mkdir -p "${dir}" || die -q "Cannot create ${dir}"

	# Prune stale managed symlinks first (e.g. utils uutils dropped
	# between upgrades) so we never leave dangling overrides behind.
	remove_managed_symlinks

	local target util link
	local -a linked=() refused=()

	for target in "${EROOT}"/usr/bin/uu-*; do
		[[ -x ${target} ]] || continue
		util=${target##*/uu-}
		link="${dir}/${util}"

		if [[ -e ${link} || -L ${link} ]] && ! is_managed_symlink "${link}"; then
			refused+=( "${util}" )
			continue
		fi

		/bin/ln -sf "/usr/bin/uu-${util}" "${link}" \
			|| die -q "Cannot link ${link} -> /usr/bin/uu-${util}"
		linked+=( "${util}" )
	done

	if [[ ${#linked[@]} -eq 0 ]]; then
		die -q "No /usr/bin/uu-* binaries found. Install sys-apps/uutils-coreutils first."
	fi

	write_kv_list_entry "linked" "${#linked[@]}"
	write_kv_list_entry "dir"    "${OVERRIDE_DIR}"
	if [[ ${#refused[@]} -gt 0 ]]; then
		write_kv_list_entry "refused" "${refused[*]}"
		write_warning_msg \
			"Refused to overwrite non-managed files in ${OVERRIDE_DIR}: ${refused[*]}"
	fi
}

validate_provider() {
	local candidate=$1 p
	for p in "${PROVIDERS[@]}"; do
		[[ ${p} == "${candidate}" ]] && return 0
	done
	return 1
}

### list action ###

describe_list() {
	echo "List available coreutils providers"
}

do_list() {
	local active provider marked i=0
	active=$(get_active_provider)

	write_list_start "Available coreutils providers:"
	for provider in "${PROVIDERS[@]}"; do
		if [[ ${provider} == "${active}" ]]; then
			marked=$(highlight_marker "${provider}")
		else
			marked=${provider}
		fi
		: $(( i++ ))
		write_numbered_list_entry "${i}" "${marked}"
	done
}

### show action ###

describe_show() {
	echo "Show the active coreutils provider"
}

do_show() {
	local active
	active=$(get_active_provider)
	if [[ -n ${active} ]]; then
		echo "${active}"
		return 0
	fi
	echo "(unset)"
	return 1
}

### set action ###

describe_set() {
	echo "Activate a coreutils provider"
}

describe_set_parameters() {
	echo "<provider>"
}

describe_set_options() {
	echo "provider : provider name (${PROVIDERS[*]}) or its list index"
}

do_set() {
	[[ $# -eq 1 ]] \
		|| die -q "Usage: eselect coreutils set <provider>"

	local target=$1 provider

	if is_number "${target}"; then
		provider=${PROVIDERS[$(( target - 1 ))]}
		[[ -n ${provider} ]] \
			|| die -q "Index out of range: ${target}"
	else
		provider=${target}
	fi

	validate_provider "${provider}" \
		|| die -q "Unknown provider: ${provider} (known: ${PROVIDERS[*]})"

	write_list_start "Activating coreutils provider: $(highlight "${provider}")"

	case ${provider} in
		gnu)
			# GNU lives at /usr/bin and is the system default. Removing
			# our overrides lets PATH resolution fall through to it.
			remove_managed_symlinks
			write_kv_list_entry "dir"  "${OVERRIDE_DIR}"
			write_kv_list_entry "note" "overrides removed; /usr/bin (GNU) wins via PATH"
			;;
		uutils)
			install_uutils_overrides
			;;
	esac

	set_active_provider "${provider}"
}

### unset action ###

describe_unset() {
	echo "Remove all overrides and clear the active provider"
}

do_unset() {
	remove_managed_symlinks
	clear_active_provider
	write_list_start "coreutils overrides removed"
}
